APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/document_intelligence
SQL_ECHO=false
LOCAL_STORAGE_PATH=./data/documents
STORAGE_BACKEND=local
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=
SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/<account-id>/document-processing
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_MINIMUM_SCORE=0.25
KNOWLEDGE_GRAPH_MODEL=gpt-6-luna
KNOWLEDGE_GRAPH_MAX_CONCEPTS=20