APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/document_intelligence
SQL_ECHO=false
LOCAL_STORAGE_PATH=./data/documents
STORAGE_BACKEND=local
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=
SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/<account-id>/document-processing
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_MINIMUM_SCORE=0.25
KNOWLEDGE_GRAPH_MODEL=gpt-6-luna
KNOWLEDGE_GRAPH_MAX_CONCEPTS=20
KNOWLEDGE_GRAPH_MAX_CHUNKS=30
ANONYMOUS_SESSION_SECRET=replace-with-a-long-random-secret
ANONYMOUS_SESSION_COOKIE=intellect_session
ANONYMOUS_SESSION_MAX_AGE_SECONDS=2592000
EXPENSIVE_RATE_LIMIT_REQUESTS=20
EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=3600
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
