# Application
APP_ENV=development
SQL_ECHO=false

# OpenAI
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GENERATION_MODEL=gpt-6-luna
GENERATION_MAX_OUTPUT_TOKENS=2400

# Session
ANONYMOUS_SESSION_SECRET=replace-with-a-long-random-secret

# Supabase PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DATABASE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Supabase Storage
STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Redis queue
JOB_QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
